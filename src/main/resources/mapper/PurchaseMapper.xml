<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yznu.abc321.dao.PurchaseDao">

    <!-- 订单查询结果映射 -->
    <resultMap id="purchaseRecordMap" type="cn.yznu.abc321.entity.PurchaseRecord">
        <result column="username" property="username"/>
        <result column="phone" property="phone"/>
        <result column="model" property="model"/>
        <result column="brand" property="brand"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="order_time" property="orderTime"/>
    </resultMap>

    <!-- 根据手机号精确查询购买记录 -->
    <select id="findByPhone" resultMap="purchaseRecordMap">
        SELECT u.username, u.phone, h.model, h.brand, h.price,
               p.quantity, p.order_time
        FROM purchase p
                 JOIN user u ON p.user_id = u.id
                 JOIN headphone h ON p.headphone_id = h.id
        WHERE u.phone = #{phone}
    </select>

    <!-- 手机号模糊匹配，返回用户列表 -->
    <select id="suggestByPhone" resultType="cn.yznu.abc321.entity.User">
        SELECT id, username, phone
        FROM user
        WHERE phone LIKE CONCAT('%', #{keyword}, '%')
            LIMIT 8
    </select>

</mapper>
